{
  "schema_id": "uus_veerenni_civic",
  "schema_version": "v1",
  "payload_schema": "payload.schema.json",
  "taxonomy_schema": "taxonomy.json",
  "card_fields": [
    "signals.desired_outcome",
    "signals.affected_group",
    "signals.service_object",
    "signals.need",
    "signals.canonical_type"
  ],
  "field_policy": {
    "signals.civic_domain": "required",
    "signals.failure_pattern": "required",
    "signals.civic_weight": "optional",
    "signals.desired_outcome": "optional",
    "signals.affected_group": "optional",
    "signals.service_object": "optional",
    "signals.need": "optional",
    "signals.ecosystem_signal": "optional",
    "signals.canonical_type": "optional",
    "geo.district": "optional",
    "geo.settlement": "optional",
    "geo.region": "optional",
    "geo.country": "optional",
    "geo.street": "optional",
    "geo.house": "optional",
    "geo.house_range": "optional",
    "geo.houses": "optional",
    "geo.detail_level": "optional"
  },
  "geo_intake": {
    "mode": "optional",
    "merge": true,
    "mirror_to_payload": true
  },
  "geo_model": {
    "precision_levels": [
      "region",
      "settlement",
      "district",
      "street",
      "house",
      "house_range",
      "coordinates"
    ],
    "default_precision_inference": "from_address_depth"
  },
  "gpt_instance_territory": {
    "enabled": true,
    "rules": [
      {
        "type": "admin_token",
        "level": "settlement",
        "value": "tallinn"
      }
    ]
  },
  "exact_lenses": [
    {
      "lens_id": "primary_story_shape",
      "source_fields": [
        "signals.civic_domain",
        "signals.failure_pattern"
      ],
      "algorithm": "exact",
      "scope": "node",
      "scale": "micro",
      "missing_value_policy": "skip",
      "min_size": 3,
      "version": "v1"
    },
    {
      "lens_id": "service_object_local",
      "source_fields": [
        "signals.service_object"
      ],
      "algorithm": "exact",
      "scope": "node",
      "scale": "local",
      "missing_value_policy": "skip",
      "min_size": 3,
      "version": "v1"
    },
    {
      "lens_id": "desired_outcome_local",
      "source_fields": [
        "signals.desired_outcome"
      ],
      "algorithm": "exact",
      "scope": "node",
      "scale": "local",
      "missing_value_policy": "skip",
      "min_size": 3,
      "version": "v1"
    },
    {
      "lens_id": "affected_group_local",
      "source_fields": [
        "signals.affected_group"
      ],
      "algorithm": "exact",
      "scope": "node",
      "scale": "local",
      "missing_value_policy": "skip",
      "min_size": 3,
      "version": "v1"
    },
    {
      "lens_id": "deep_need_local",
      "source_fields": [
        "signals.need"
      ],
      "algorithm": "exact",
      "scope": "node",
      "scale": "local",
      "missing_value_policy": "skip",
      "min_size": 3,
      "version": "v1"
    }
  ],
  "node_clustering": {
    "civic": {
      "active_lenses": [
        "primary_story_shape",
        "service_object_local",
        "desired_outcome_local",
        "affected_group_local",
        "deep_need_local"
      ],
      "primary_lens": "primary_story_shape",
      "min_size": 3,
      "readiness_threshold": 50,
      "signal_source": "canonical",
      "id_algorithm": "sha256",
      "geo_filter": "settlement",
      "geo_scope": "settlement:tallinn",
      "tie_breaker": "alpha",
      "type_resolution": "canonical_priority",
      "semantic_merge_policy": "balanced_functional_similarity",
      "preserve_distinct_variants": true,
      "community_focus": "Uus Veerenni residents and directly affecting adjacent Tallinn infrastructure/services"
    }
  }
}
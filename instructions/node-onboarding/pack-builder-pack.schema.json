{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dogestonia.local/pack-builder/pack-builder-pack.schema.json",
  "title": "Pack Builder meta-schema — candidate pack.json",
  "description": "Validates Pack Builder candidate pack.json. Full top-level branch skeleton required; tallinn_civic/v1 is a minimal exemplar only (not deep enrichment). Protocol: semantic align with gateway schema-packs; on federation drift gateway wins. MUST NOT rewrite Module-1 interview process. GPT-PB-06: exact_lenses = ExactLensBlock + minItems 1; node_clustering.civic = _CIVIC_REQUIRED_KEYS + ClusterLens. GPT-PB-07: geo_intake.mode ∈ GEO_INTAKE_MODES; geo_intake keys mode/merge/mirror_to_payload only; field_policy values ∈ FIELD_POLICY_STATES.",
  "$comment": "REQ-46 §5.0 · GPT-PB-03 · GPT-PB-06 · GPT-PB-07 · AC-GPT-PB07-01…03 · handoff Part A 2026-09-04 · cite contracts.py GEO_INTAKE_MODES L75–77 / FIELD_POLICY_STATES L10–20 · resolver.py _parse_geo_intake L420–447 · ExactLensBlock/ClusterLens (PB-06) · gateway wins on drift · no Module-1 process edits · standards_set_hash → PB-09",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "payload_schema",
    "taxonomy_schema",
    "field_policy",
    "geo_intake",
    "geo_model",
    "gpt_instance_territory",
    "exact_lenses",
    "node_clustering"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "minLength": 1,
      "description": "Pack model id (not envelope m2.story_intake_envelope.v2).",
      "examples": ["tallinn_civic"]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic pack version string.",
      "examples": ["v1"]
    },
    "payload_schema": {
      "type": "string",
      "description": "Relative or logical pointer to companion payload schema artifact name.",
      "examples": ["payload.schema.json"]
    },
    "taxonomy_schema": {
      "type": "string",
      "description": "Relative or logical pointer to companion taxonomy artifact name.",
      "examples": ["taxonomy.json"]
    },
    "field_policy": {
      "type": "object",
      "description": "Map of field path → policy state. Values MUST ∈ FIELD_POLICY_STATES (contracts.py L10–20). Full branch MUST exist; tallinn exemplar uses a small signal/geo subset.",
      "$comment": "GPT-PB-07 T03 · FIELD_POLICY_STATES ×7 · resolver.py L645–648",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "enum": [
          "required",
          "optional",
          "disabled",
          "forbidden",
          "node_private",
          "derived",
          "computed_aggregate_only"
        ]
      },
      "examples": [
        {
          "signals.civic_domain": "required",
          "geo.settlement": "optional"
        }
      ]
    },
    "geo_intake": {
      "type": "object",
      "description": "Geo intake GeoIntakeBlock: mode + merge + mirror_to_payload only (resolver.py _parse_geo_intake). mode ∈ GEO_INTAKE_MODES.",
      "$comment": "GPT-PB-07 T01/T02 · GEO_INTAKE_MODES contracts.py L75–77 · unknown keys reject",
      "required": ["mode", "merge", "mirror_to_payload"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "optional",
            "require_location_or_detail",
            "require_detail"
          ],
          "description": "Gateway GEO_INTAKE_MODES only — not 'required' or 'disabled'."
        },
        "merge": { "type": "boolean" },
        "mirror_to_payload": { "type": "boolean" }
      },
      "examples": [
        { "mode": "optional", "merge": true, "mirror_to_payload": true }
      ]
    },
    "geo_model": {
      "type": "object",
      "description": "Geo model / precision branch. MUST include precision_levels skeleton; tallinn lists a short level set only.",
      "required": ["precision_levels"],
      "additionalProperties": true,
      "properties": {
        "precision_levels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "examples": [["region", "settlement"]]
        },
        "default_precision_inference": {
          "description": "Optional inference table/object; structure free at meta level."
        }
      }
    },
    "gpt_instance_territory": {
      "type": "object",
      "description": "GPT-instance territory hooks (enabled + rules). Tallinn exemplar: settlement=tallinn only — do not copy deep rule catalogs.",
      "required": ["enabled", "rules"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "rules": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "examples": [
        {
          "enabled": true,
          "rules": [
            { "type": "admin_token", "level": "settlement", "value": "tallinn" }
          ]
        }
      ]
    },
    "exact_lenses": {
      "type": "array",
      "minItems": 1,
      "description": "Exact-lens definitions. MUST be non-empty (gateway resolver.py exact_lenses non-empty). Each item = ExactLensBlock incl. nested readiness_policy (contracts.py).",
      "$comment": "GPT-PB-06 T02 minItems:1 · resolver.py L650–652 · ExactLensBlock contracts.py L38–48 · _parse_lens L605–617 · ReadinessPolicy L29–35",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "lens_id",
          "source_fields",
          "algorithm",
          "scope",
          "scale",
          "missing_value_policy",
          "min_size",
          "readiness_policy",
          "version"
        ],
        "properties": {
          "lens_id": { "type": "string", "minLength": 1 },
          "source_fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "algorithm": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "scale": { "type": "string", "minLength": 1 },
          "missing_value_policy": { "type": "string", "minLength": 1 },
          "min_size": { "type": "integer" },
          "version": { "type": "string", "minLength": 1 },
          "readiness_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min_readiness_score",
              "min_stories",
              "require_actionable_canonical_type"
            ],
            "properties": {
              "min_readiness_score": { "type": "integer" },
              "min_stories": { "type": "integer" },
              "require_actionable_canonical_type": { "type": "boolean" }
            }
          }
        }
      }
    },
    "node_clustering": {
      "type": "object",
      "description": "Node clustering branch. Gateway requires node_clustering.civic with full _CIVIC_REQUIRED_KEYS (resolver.py L35–47, L95–108). Empty {} fails. primary_lens MUST be ∈ ClusterLens and ∈ active_lenses at runtime (JSON Schema enforces ClusterLens enum; ∈ active documented).",
      "$comment": "GPT-PB-06 T03/T04 · ClusterLens types.py L10–22 · _CIVIC_REQUIRED_KEYS resolver.py L35–47",
      "additionalProperties": true,
      "required": ["civic"],
      "properties": {
        "civic": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "active_lenses",
            "primary_lens",
            "min_size",
            "min_size_by_lens",
            "readiness_threshold",
            "signal_source",
            "id_algorithm",
            "geo_filter",
            "geo_scope",
            "tie_breaker",
            "type_resolution"
          ],
          "properties": {
            "active_lenses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "composite_primary_micro",
                  "civic_domain_micro",
                  "failure_pattern_micro",
                  "civic_weight_systemic",
                  "desired_outcome_local",
                  "affected_group_local",
                  "geographic_district_micro",
                  "service_object_micro",
                  "deep_need_local",
                  "ecosystem_signal_systemic"
                ]
              },
              "description": "Non-empty ClusterLens ids (types.py ClusterLens / resolver _KNOWN_LENS_IDS)."
            },
            "primary_lens": {
              "type": "string",
              "enum": [
                "composite_primary_micro",
                "civic_domain_micro",
                "failure_pattern_micro",
                "civic_weight_systemic",
                "desired_outcome_local",
                "affected_group_local",
                "geographic_district_micro",
                "service_object_micro",
                "deep_need_local",
                "ecosystem_signal_systemic"
              ],
              "description": "Must be ∈ ClusterLens; gateway also requires ∈ active_lenses (resolver.py L139–142) — document-enforced here."
            },
            "min_size": { "type": "integer", "minimum": 1 },
            "min_size_by_lens": {
              "type": "object",
              "description": "Map ClusterLens id → positive int (resolver.py min_size_by_lens).",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              },
              "propertyNames": {
                "enum": [
                  "composite_primary_micro",
                  "civic_domain_micro",
                  "failure_pattern_micro",
                  "civic_weight_systemic",
                  "desired_outcome_local",
                  "affected_group_local",
                  "geographic_district_micro",
                  "service_object_micro",
                  "deep_need_local",
                  "ecosystem_signal_systemic"
                ]
              }
            },
            "readiness_threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "signal_source": { "type": "string", "minLength": 1 },
            "id_algorithm": { "type": "string", "minLength": 1 },
            "geo_filter": { "type": "string", "minLength": 1 },
            "geo_scope": {
              "description": "String token (e.g. settlement:tallinn) or null — resolver.py L193–204.",
              "type": ["string", "null"]
            },
            "tie_breaker": { "type": "string", "minLength": 1 },
            "type_resolution": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "card_fields": {
      "type": "array",
      "description": "Optional card_fields branch — when present, array of field paths.",
      "items": { "type": "string" },
      "examples": [["signals.desired_outcome", "signals.affected_group"]]
    }
  },
  "examples": [
    {
      "schema_id": "tallinn_civic",
      "schema_version": "v1",
      "payload_schema": "payload.schema.json",
      "taxonomy_schema": "taxonomy.json",
      "field_policy": {
        "signals.civic_domain": "required",
        "geo.settlement": "optional"
      },
      "geo_intake": {
        "mode": "optional",
        "merge": true,
        "mirror_to_payload": true
      },
      "geo_model": {
        "precision_levels": ["region", "settlement"]
      },
      "gpt_instance_territory": {
        "enabled": true,
        "rules": [
          { "type": "admin_token", "level": "settlement", "value": "tallinn" }
        ]
      },
      "exact_lenses": [
        {
          "lens_id": "civic_domain_micro",
          "source_fields": ["signals.civic_domain"],
          "algorithm": "exact",
          "scope": "node",
          "scale": "micro",
          "missing_value_policy": "skip",
          "min_size": 3,
          "version": "v1",
          "readiness_policy": {
            "min_readiness_score": 35,
            "min_stories": 3,
            "require_actionable_canonical_type": false
          }
        }
      ],
      "node_clustering": {
        "civic": {
          "active_lenses": [
            "composite_primary_micro",
            "civic_domain_micro"
          ],
          "primary_lens": "composite_primary_micro",
          "min_size": 5,
          "min_size_by_lens": {
            "composite_primary_micro": 8,
            "civic_domain_micro": 3
          },
          "readiness_threshold": 60,
          "signal_source": "canonical",
          "id_algorithm": "sha256",
          "geo_filter": "country",
          "geo_scope": "settlement:tallinn",
          "tie_breaker": "alpha",
          "type_resolution": "canonical_priority"
        }
      },
      "card_fields": ["signals.desired_outcome"]
    }
  ]
}
